{
  "name": "crd-rebalancer-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Manual + automated tests for the CRD portfolio rebalancing assessment",
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
